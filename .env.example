# このファイルを .env にコピーして、実際の値を入力してください。
# .env は絶対にGitにコミット・公開しないでください。

# Bluesky ログイン情報（アプリパスワードを使用すること。メインパスワードは使わない）
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_PASSWORD=xxxx-xxxx-xxxx-xxxx

# （任意）積極的にいいね・リポストしたい特定アカウント。空欄なら機能を無効化。
BLUESKY_TARGET_ACCOUNT=

# （任意）アフィリエイト投稿で画像はあるがタイトル/説明/リンク先URLが
# 指定されていない場合に使われるデフォルト値。
DEFAULT_AFFILIATE_TITLE=おすすめサービス
DEFAULT_AFFILIATE_DESC=詳しくはリンク先をご覧ください
DEFAULT_AFFILIATE_URL=
